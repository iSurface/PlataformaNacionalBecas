# ==========================================
# CONFIGURACIÓN DEL ENTORNO LOCAL (SPRINT 1)
# ==========================================
PROJECT_NAME="Plataforma Nacional de Becas - API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Base de Datos PostgreSQL Local (Docker)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_2026!
POSTGRES_DB=becas_db

# Seguridad JWT y Criptografía (Algoritmo HS256 para local / RS256 para producción)
JWT_SECRET_KEY=dev_insecure_jwt_secret_change_in_production_key_min_64_bytes_becas_2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACTIVATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Servicio de Correo (Mailpit local para pruebas)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@becas.mineduc.gob.gt
EMAILS_FROM_NAME="Sistema Nacional de Becas MINEDUC"

# Google OAuth 2.0 (HU-001)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
